# ==============================================================================
# Near4You (Near4Pay) Environment Configuration Template
# Sathus Technology Pvt. Ltd.
#
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this file to .env.local for local development.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SQLite Database Location (defaults to data/near4you.db if omitted)
DATABASE_PATH=data/near4you.db

# Authentication Session Secret (at least 32 random characters for HMAC signatures)
SESSION_SECRET=replace_with_a_secure_random_32_byte_hex_string_for_production

# Razorpay Payment Gateway Credentials
# For local development and CI sandbox testing, leave empty or set to test keys.
# The system automatically runs in authenticated Sandbox mode if placeholder/test keys are used.
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=replace_with_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Public Key exposed to frontend checkout widgets
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id

# Rate Limiting & Security
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=60000
